# Copy to .env.local and export these values from your shell. Do not commit
# credentials, wallets, Oracle client libraries, or database artifacts.
ORKIDEA_ADBC_URI=oracle://user:password@127.0.0.1:1521/service
ORKIDEA_ADBC_LIBRARY=/absolute/path/to/target/release/libadbc_driver_orkidea.so
ORKIDEA_ADBC_EXTENSION=/absolute/path/to/orkidea_adbc.duckdb_extension
